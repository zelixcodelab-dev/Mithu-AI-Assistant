APP_ENV=development
SERVICE_NAME=mithu-ai
PORT=8100
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Never point this at EduConnect tenant/platform databases.
MITHU_MONGODB_URI=
MITHU_DATABASE_NAME=educonnect_mithu
MITHU_STORE_CONVERSATIONS=true
IDENTITY_ISSUER=educonnect-pro
IDENTITY_AUDIENCE=mithu-ai
IDENTITY_PUBLIC_KEY_PEM=
# Disabled until the EduConnect-side identity verifier and read-only gateway exist.
EDUCONNECT_API_ENABLED=false
EDUCONNECT_INTERNAL_API_URL=
EDUCONNECT_SERVICE_TOKEN=
# ElevenLabs Conversational AI. Server-side only.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_SERVER_LOCATION=in-residency
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
