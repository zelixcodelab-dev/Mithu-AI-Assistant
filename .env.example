APP_ENV=development
SERVICE_NAME=mithu-ai
PORT=8100
LOG_LEVEL=INFO

# Server-side OpenAI key. Never expose this to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
MITHU_LIVE_MODEL=gpt-live-1.1
MITHU_LIVE_VOICE=marin
MITHU_RESPONSES_MODEL=gpt-6-luna
OPENAI_SAFETY_IDENTIFIER_SECRET=

# Never point this at EduConnect tenant/platform databases.
MITHU_MONGODB_URI=
MITHU_DATABASE_NAME=educonnect_mithu
MITHU_STORE_CONVERSATIONS=true

# Ed25519 public key used to verify identities signed by EduConnect.
IDENTITY_ISSUER=educonnect-pro
IDENTITY_AUDIENCE=mithu-ai
IDENTITY_PUBLIC_KEY_PEM=

# Shared server-to-server credential. Match MITHU_SERVICE_TOKEN in EduConnect.
MITHU_PROXY_TOKEN=

# Disabled until the EduConnect internal read-only gateway is deployed.
EDUCONNECT_API_ENABLED=false
EDUCONNECT_INTERNAL_API_URL=
EDUCONNECT_SERVICE_TOKEN=

CORS_ORIGINS=http://localhost:3000
